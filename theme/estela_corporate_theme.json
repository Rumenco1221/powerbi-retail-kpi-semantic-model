{
  "name": "Estela Oviedo · Corporate Data",
  "dataColors": ["#1E3A8A", "#2563EB", "#0EA5E9", "#14B8A6", "#F59E0B", "#EF4444", "#8B5CF6", "#64748B"],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#1E3A8A",
  "good": "#16A34A",
  "neutral": "#F59E0B",
  "bad": "#DC2626",
  "maximum": "#1E3A8A",
  "center": "#93C5FD",
  "minimum": "#EFF6FF",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#111827" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F2937" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#4B5563" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#1E3A8A" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E5E7EB" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }]
      }
    },
    "page": {
      "*": { "background": [{ "color": { "solid": { "color": "#F3F4F6" } }, "transparency": 0 }] }
    }
  }
}
